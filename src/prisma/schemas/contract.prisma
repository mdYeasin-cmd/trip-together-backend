// use prisma-8
model User {
  id                    String               @id @onCreate(uuid())
  name                  String
  email                 String               @unique
  password              String
  needPasswordChange    Boolean              @default(true)
  role                  UserRole
  status                UserStatus           @default(ACTIVE)
  isDeleted             Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             temporal.UpdatedAt
  userProfile           UserProfile?
  trips                 Trip[]

  sentBuddyRequests     TravelBuddyRequest[] @relation("BuddyUser")
  receivedBuddyRequests TravelBuddyRequest[] @relation("InvitedBy")

  @@map("users")
}

model UserProfile {
  id        String             @id @onCreate(uuid())
  userId    String             @unique
  bio       String?
  age       Int?
  gender    Gender?
  createdAt DateTime           @default(now())
  updatedAt temporal.UpdatedAt

  user      User               @relation(fields: [userId], references: [id])

  @@map("user_profiles")
}

model Trip {
  id                  String               @id @onCreate(uuid())
  userId              String
  photos              Json
  destination         String
  travelType          String
  budget              Float
  startDate           DateTime
  endDate             DateTime
  description         String
  isDeleted           Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           temporal.UpdatedAt
  travelBuddyRequests TravelBuddyRequest[]

  user                User                 @relation(fields: [userId], references: [id])

  @@map("trips")
}

model TravelBuddyRequest {
  id          String                   @id @onCreate(uuid())
  tripId      String
  userId      String
  invitedById String?
  type        TravelBuddyRequestType
  status      TravelBuddyRequestStatus @default(PENDING)
  isDeleted   Boolean                  @default(false)
  createdAt   DateTime                 @default(now())
  updatedAt   temporal.UpdatedAt

  trip        Trip                     @relation(fields: [tripId], references: [id])
  user        User                     @relation("BuddyUser", fields: [userId], references: [id])
  invitedBy   User?                    @relation("InvitedBy", fields: [invitedById], references: [id])

  @@map("travel_buddy_requests")
}
